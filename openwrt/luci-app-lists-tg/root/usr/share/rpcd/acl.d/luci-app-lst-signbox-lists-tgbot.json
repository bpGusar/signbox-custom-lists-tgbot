{
  "luci-app-lst-signbox-lists-tgbot": {
    "description": "Grant access to Lists Telegram Bot configuration",
    "read": {
      "cgi-io": [
        "exec"
      ],
      "file": {
        "/etc/init.d/lst-signbox-lists-tgbot": [
          "exec"
        ],
        "/usr/sbin/lst-signbox-lists-tgbot-upgrade": [
          "exec"
        ],
        "/bin/tail": [
          "exec"
        ],
        "/tmp/lst-signbox-lists-tgbot-upgrade.log": [
          "read"
        ],
        "/etc/lst-signbox-lists-tgbot/*": [
          "read"
        ]
      },
      "uci": [
        "lst-signbox-lists-tgbot"
      ]
    },
    "write": {
      "uci": [
        "lst-signbox-lists-tgbot"
      ]
    }
  }
}
