#!/bin/sh
# Upgrade lst-signbox-lists-tgbot and luci-app-lst-signbox-lists-tgbot from GitHub Release.
#
# Usage:
#   lst-signbox-lists-tgbot-upgrade check   — print version JSON to stdout
#   lst-signbox-lists-tgbot-upgrade start   — begin background upgrade
#   lst-signbox-lists-tgbot-upgrade status  — print state JSON to stdout

set -eu

REPO_API="https://api.github.com/repos/bpGusar/signbox-custom-lists-tgbot/releases/latest"
REPO_OWNER="bpGusar"
REPO_NAME="signbox-custom-lists-tgbot"
REPO_BRANCH="${LST_SIGNBOX_LISTS_TGBOT_REPO_BRANCH:-main}"
DIST_RAW_URL="https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${REPO_BRANCH}/dist"
DOWNLOAD_DIR="/tmp/lst-signbox-lists-tgbot-install"
LOG="/tmp/lst-signbox-lists-tgbot-upgrade.log"
LOCK="/tmp/lst-signbox-lists-tgbot-upgrade.lock"
VERSION_CACHE="/tmp/lst-signbox-lists-tgbot-upgrade.versions"
RETRIES=3
DOWNLOAD_TIMEOUT=60

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

die() {
	log "ERROR: $*"
	return 1
}

need_root() {
	[ "$(id -u)" -eq 0 ] || die "run as root"
}

# OpenWrt 25.12 replaced opkg with apk, and the packages are built for each.
if command -v apk >/dev/null 2>&1; then
	PKG_MGR="apk"
	PKG_EXT="apk"
else
	PKG_MGR="opkg"
	PKG_EXT="ipk"
fi

need_openwrt() {
	command -v "$PKG_MGR" >/dev/null 2>&1 || die "neither apk nor opkg found"
	[ -f /etc/openwrt_release ] || die "unsupported system"
}

detect_arch() {
	# shellcheck disable=SC1091
	. /etc/openwrt_release
	[ -n "${DISTRIB_ARCH:-}" ] || die "cannot detect DISTRIB_ARCH"
	printf '%s' "$DISTRIB_ARCH"
}

normalize_ver() {
	echo "$1" | sed 's/^v//I;s/-r.*//;s/^[[:space:]]*//;s/[[:space:]]*$//'
}

ver_lt() {
	local a b
	a="$(normalize_ver "$1")"
	b="$(normalize_ver "$2")"
	[ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ] && [ "$a" = "$(printf '%s\n%s' "$a" "$b" | sort -V | head -n1)" ]
}

installed_version() {
	if [ "$PKG_MGR" = "apk" ]; then
		apk list --installed lst-signbox-lists-tgbot 2>/dev/null |
			awk '$1 ~ /^lst-signbox-lists-tgbot-[0-9]/ {sub(/^lst-signbox-lists-tgbot-/, "", $1); print $1; exit}'
		return
	fi
	opkg info lst-signbox-lists-tgbot 2>/dev/null | awk -F': ' '/^Version:/{print $2; exit}'
}

# Quiet on purpose: callers print JSON to stdout, so nothing here may log.
fetch_api_response() {
	local out=""

	if command -v curl >/dev/null 2>&1; then
		out="$(curl -fsSL --max-time 20 "$REPO_API" 2>/dev/null || true)"
		[ -n "$out" ] && { printf '%s' "$out"; return 0; }
	fi
	if command -v wget >/dev/null 2>&1; then
		out="$(wget -qO- -T 20 "$REPO_API" 2>/dev/null || true)"
		[ -n "$out" ] && { printf '%s' "$out"; return 0; }
	fi
	if command -v uclient-fetch >/dev/null 2>&1; then
		out="$(uclient-fetch -qO- -T 20 "$REPO_API" 2>/dev/null || true)"
		[ -n "$out" ] && { printf '%s' "$out"; return 0; }
	fi
	return 1
}

fetch_latest_version() {
	local api_response tag
	api_response="$(fetch_api_response)" || return 1
	[ -n "$api_response" ] || return 1
	if printf '%s' "$api_response" | grep -q 'API rate limit'; then
		return 1
	fi
	tag="$(printf '%s' "$api_response" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')"
	[ -n "$tag" ] || return 1
	normalize_ver "$tag"
}

# OpenWrt's default /usr/bin/wget is uclient-fetch, which on some builds
# segfaults while following GitHub's redirect to objects.githubusercontent.com
# and dies with "Failed to send request: Operation not permitted" on others.
# curl copes with both, so try it first and fall back to whatever else is there.
download_backends() {
	local wget_bin uclient_bin

	if command -v curl >/dev/null 2>&1; then
		printf 'curl\n'
	fi

	wget_bin="$(command -v wget 2>/dev/null || true)"
	uclient_bin="$(command -v uclient-fetch 2>/dev/null || true)"

	if [ -n "$wget_bin" ]; then
		printf 'wget\n'
	fi
	if [ -n "$uclient_bin" ] && \
		[ "$(readlink -f "$wget_bin" 2>/dev/null || true)" != "$(readlink -f "$uclient_bin" 2>/dev/null || true)" ]; then
		printf 'uclient-fetch\n'
	fi
	return 0
}

run_download_backend() {
	local backend="$1"
	local url="$2"
	local dest="$3"

	case "$backend" in
		curl)          curl -fsS -L --connect-timeout 15 --max-time "$DOWNLOAD_TIMEOUT" -o "$dest" "$url" ;;
		wget)          wget -q -T "$DOWNLOAD_TIMEOUT" -O "$dest" "$url" ;;
		uclient-fetch) uclient-fetch -q -T "$DOWNLOAD_TIMEOUT" -O "$dest" "$url" ;;
		*)             return 127 ;;
	esac
}

download_file() {
	local url="$1"
	local dest="$2"
	local attempt=0
	local backend rc

	while [ "$attempt" -lt "$RETRIES" ]; do
		attempt=$((attempt + 1))
		for backend in $(download_backends); do
			log "download $(basename "$dest") via ${backend} (attempt ${attempt}/${RETRIES})"
			rc=0
			run_download_backend "$backend" "$url" "$dest" || rc=$?
			if [ "$rc" -eq 0 ] && [ -s "$dest" ]; then
				return 0
			fi
			log "${backend} failed (exit ${rc})"
			rm -f "$dest"
		done
		if [ "$attempt" -lt "$RETRIES" ]; then
			sleep 2
		fi
	done
	return 1
}

manifest_package_name() {
	local manifest="$1"
	local package="$2"
	local arch="$3"
	local section="packages"
	local template

	[ "$PKG_EXT" = "apk" ] && section="apk_packages"
	template="$(sed -n "/\"${section}\"/,/^ *}/p" "$manifest" | grep -F "\"${package}\"" | sed -n 's/.*: *"\([^"]*\)".*/\1/p' | head -n 1)"
	[ -n "$template" ] || return 1
	printf '%s' "$template" | sed "s/\${ARCH}/${arch}/g"
}

resolve_package_names() {
	local arch="$1"
	local manifest="${DOWNLOAD_DIR}/manifest.json"

	PACKAGE_LISTS="$(manifest_package_name "$manifest" "lst-signbox-lists-tgbot" "$arch")"
	[ -n "$PACKAGE_LISTS" ] || return 1
	PACKAGE_LUCI="$(manifest_package_name "$manifest" "luci-app-lst-signbox-lists-tgbot" "$arch")"
	[ -n "$PACKAGE_LUCI" ] || return 1
	return 0
}

fetch_manifest() {
	local arch="$1"
	local dest="${DOWNLOAD_DIR}/manifest.json"
	local manifest_url="${DIST_RAW_URL}/manifest.json"

	download_file "$manifest_url" "$dest" || return 1
	resolve_package_names "$arch"
}

release_asset_url() {
	local api_response="$1"
	local filename="$2"

	printf '%s' "$api_response" | grep -F "$filename" | grep -o 'https://[^"[:space:]]*' | head -n 1
}

release_package_names() {
	local arch="$1"
	local api_response="$2"
	local release_ver

	release_ver="$(printf '%s' "$api_response" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"v[^"]*"' | head -n 1 | sed 's/.*"v\([^"]*\)".*/\1/')"
	[ -n "$release_ver" ] || return 1

	PACKAGE_LISTS="lst-signbox-lists-tgbot_${release_ver}-r1_${arch}.${PKG_EXT}"
	PACKAGE_LUCI="luci-app-lst-signbox-lists-tgbot_${release_ver}-r1_all.${PKG_EXT}"
	return 0
}

fetch_from_release() {
	local arch="$1"
	local api_response url

	api_response="$(fetch_api_response)"
	[ -n "$api_response" ] || return 1
	release_package_names "$arch" "$api_response" || return 1

	url="$(release_asset_url "$api_response" "$PACKAGE_LISTS")"
	[ -n "$url" ] || return 1
	download_file "$url" "${DOWNLOAD_DIR}/${PACKAGE_LISTS}" || return 1

	url="$(release_asset_url "$api_response" "$PACKAGE_LUCI")"
	[ -n "$url" ] || return 1
	download_file "$url" "${DOWNLOAD_DIR}/${PACKAGE_LUCI}" || return 1
	return 0
}

fetch_from_raw() {
	local arch="$1"
	local base_url="${LST_SIGNBOX_LISTS_TGBOT_REPO_URL:-${DIST_RAW_URL}/${PKG_EXT}}"

	log "fallback: raw packages from ${base_url}/${arch}"
	fetch_manifest "$arch" || return 1
	download_file "${base_url}/${arch}/${PACKAGE_LISTS}" "${DOWNLOAD_DIR}/${PACKAGE_LISTS}" || return 1
	download_file "${base_url}/${arch}/${PACKAGE_LUCI}" "${DOWNLOAD_DIR}/${PACKAGE_LUCI}" || return 1
	return 0
}

fetch_packages() {
	local arch="$1"

	rm -rf "$DOWNLOAD_DIR"
	mkdir -p "$DOWNLOAD_DIR"

	if fetch_from_release "$arch"; then
		return 0
	fi
	if fetch_from_raw "$arch"; then
		return 0
	fi

	die "no packages found for ${arch}"
	return 1
}

backup_current_config() {
	PREV_ENABLED="$(uci -q get lst-signbox-lists-tgbot.main.enabled || true)"
	PREV_TOKEN="$(uci -q get lst-signbox-lists-tgbot.main.token || true)"
	PREV_RESTART_CMD="$(uci -q get lst-signbox-lists-tgbot.main.restart_cmd || true)"
	PREV_SERVICE_LABEL="$(uci -q get lst-signbox-lists-tgbot.main.service_label || true)"
	PREV_STATE_PATH="$(uci -q get lst-signbox-lists-tgbot.main.state_path || true)"
	PREV_LOG_PATH="$(uci -q get lst-signbox-lists-tgbot.main.log_path || true)"
	PREV_AUTO_RESTART="$(uci -q get lst-signbox-lists-tgbot.main.auto_restart || true)"
}

restore_config() {
	local changed=0

	if [ -n "$PREV_ENABLED" ]; then
		uci set "lst-signbox-lists-tgbot.main.enabled=${PREV_ENABLED}"
		changed=1
	fi
	if [ -n "$PREV_TOKEN" ]; then
		uci set "lst-signbox-lists-tgbot.main.token=${PREV_TOKEN}"
		changed=1
	fi
	uci -q delete lst-signbox-lists-tgbot.main.domain_list && changed=1
	uci -q delete lst-signbox-lists-tgbot.main.ip_list && changed=1
	if [ -n "$PREV_RESTART_CMD" ]; then
		uci set "lst-signbox-lists-tgbot.main.restart_cmd=${PREV_RESTART_CMD}"
		changed=1
	fi
	if [ -n "$PREV_SERVICE_LABEL" ]; then
		uci set "lst-signbox-lists-tgbot.main.service_label=${PREV_SERVICE_LABEL}"
		changed=1
	fi
	if [ -n "$PREV_STATE_PATH" ]; then
		uci set "lst-signbox-lists-tgbot.main.state_path=${PREV_STATE_PATH}"
		changed=1
	fi
	if [ -n "$PREV_LOG_PATH" ]; then
		uci set "lst-signbox-lists-tgbot.main.log_path=${PREV_LOG_PATH}"
		changed=1
	fi
	if [ -n "$PREV_AUTO_RESTART" ]; then
		uci set "lst-signbox-lists-tgbot.main.auto_restart=${PREV_AUTO_RESTART}"
		changed=1
	fi

	if [ "$changed" -eq 1 ]; then
		uci commit lst-signbox-lists-tgbot
	fi
}

pkg_locked() {
	printf '%s' "$1" | grep -q -i -e 'Could not lock .*opkg\.lock' -e 'unable to lock database'
}

# opkg exits non-zero whenever it prints a "Collected errors:" block, even
# when the only entry is a benign resolve_conffiles notice (existing
# conffile kept, new default saved as *-opkg). Treat that case as success.
opkg_only_conffile_errors() {
	local out="$1"
	local extra

	printf '%s\n' "$out" | grep -q '^Collected errors:' || return 1
	extra="$(printf '%s\n' "$out" | sed -n '/^Collected errors:/,$p' | tail -n +2 | grep -v 'resolve_conffiles:' || true)"
	[ -z "$extra" ]
}

# apk keeps a changed conffile on its own (the new default goes to *.apk-new)
# and exits 0, so only opkg needs the conffile workaround.
pkg_install_retry() {
	local attempt=0
	local max_attempts=5
	local out=""

	while [ "$attempt" -lt "$max_attempts" ]; do
		if [ "$PKG_MGR" = "apk" ]; then
			out="$(apk add "$@" 2>&1)" && return 0
		else
			if out="$(opkg install "$@" 2>&1)"; then
				return 0
			fi
			if opkg_only_conffile_errors "$out"; then
				log "opkg install ok (existing conffile kept, new default saved as -opkg)"
				return 0
			fi
		fi
		attempt=$((attempt + 1))
		if pkg_locked "$out" && [ "$attempt" -lt "$max_attempts" ]; then
			log "${PKG_MGR} locked, retrying (${attempt}/${max_attempts})"
			sleep 2
			continue
		fi
		[ -n "$out" ] && log "${PKG_MGR} install failed: $out"
		return 1
	done
	return 1
}

pkg_install_file_retry() {
	if [ "$PKG_MGR" = "apk" ]; then
		pkg_install_retry --allow-untrusted --force-reinstall "$1"
	else
		pkg_install_retry --force-reinstall --force-downgrade "$1"
	fi
}

pkg_update() {
	if [ "$PKG_MGR" = "apk" ]; then
		apk update
	else
		opkg update
	fi
}

# Downloading is the step that fails first on a router whose only fetcher is a
# broken uclient-fetch, so pull curl (and the CA bundle it needs) in before the
# downloads rather than after them.
prepare_download_tools() {
	if command -v curl >/dev/null 2>&1; then
		return 0
	fi
	log "curl not found, installing it for downloads"
	pkg_update >/dev/null 2>&1 || true
	pkg_install_retry ca-bundle curl >/dev/null 2>&1 || true
	if ! command -v curl >/dev/null 2>&1; then
		log "curl unavailable, falling back to wget"
	fi
	return 0
}

install_packages() {
	local arch="$1" lists_pkg luci_pkg

	log "updating package lists"
	pkg_update >/dev/null 2>&1 || true
	pkg_install_retry ca-bundle wget >/dev/null 2>&1 || true
	pkg_install_retry luci-base luci-compat >/dev/null 2>&1 || true

	log "installing lst-signbox-lists-tgbot (${arch}, ${PKG_MGR})"
	lists_pkg="${DOWNLOAD_DIR}/${PACKAGE_LISTS}"
	[ -f "$lists_pkg" ] || { die "lst-signbox-lists-tgbot package not found"; return 1; }
	pkg_install_file_retry "$lists_pkg" || { die "${PKG_MGR} install failed for bot package"; return 1; }

	log "installing luci-app-lst-signbox-lists-tgbot"
	luci_pkg="${DOWNLOAD_DIR}/${PACKAGE_LUCI}"
	[ -f "$luci_pkg" ] || { die "luci-app package not found"; return 1; }
	pkg_install_file_retry "$luci_pkg" || { die "${PKG_MGR} install failed for luci package"; return 1; }
	rm -f /tmp/luci-indexcache /tmp/luci-modulecache 2>/dev/null || true
}

restart_service() {
	log "restarting lst-signbox-lists-tgbot service"
	/etc/init.d/lst-signbox-lists-tgbot enable
	/etc/init.d/lst-signbox-lists-tgbot restart || /etc/init.d/lst-signbox-lists-tgbot start || true
}

upgrade_running() {
	[ -f "$LOCK" ]
}

upgrade_state() {
	if upgrade_running; then
		printf 'running'
	elif [ -f "$LOG" ] && grep -q '^STATUS=success$' "$LOG" 2>/dev/null; then
		printf 'success'
	elif [ -f "$LOG" ] && grep -q '^STATUS=error$' "$LOG" 2>/dev/null; then
		printf 'failed'
	else
		printf 'idle'
	fi
}

json_bool() {
	[ "$1" = "1" ] && printf 'true' || printf 'false'
}

print_version_json() {
	local current="$1"
	local latest="$2"
	local update_available="$3"
	local running="$4"
	local state="${5:-idle}"

	printf '{"current":"%s","latest":"%s","update_available":%s,"running":%s,"state":"%s"}\n' \
		"$current" "$latest" "$(json_bool "$update_available")" "$(json_bool "$running")" "$state"
}

write_version_cache() {
	printf 'CURRENT=%s\nLATEST=%s\n' "$1" "$2" > "$VERSION_CACHE"
}

# While an upgrade is running, the install holds the package manager's global
# lock for the whole install. The LuCI page polls `status` every couple of
# seconds (see UPGRADE_POLL_INTERVAL in the frontend), and re-querying the
# installed version here would fight that same lock, causing spurious "locked,
# retrying" loops in the running install. Serve cached values instead while
# running.
build_version_info() {
	local current latest update_available running state

	running=0
	upgrade_running && running=1

	if [ "$running" -eq 1 ] && [ -f "$VERSION_CACHE" ]; then
		current="$(sed -n 's/^CURRENT=//p' "$VERSION_CACHE")"
		latest="$(sed -n 's/^LATEST=//p' "$VERSION_CACHE")"
	else
		current="$(installed_version)"
		latest="$(fetch_latest_version)" || latest=""
	fi

	update_available=0
	if [ -n "$latest" ] && [ -n "$current" ]; then
		if ver_lt "$current" "$latest"; then
			update_available=1
		fi
	fi
	state="$(upgrade_state)"
	print_version_json "$current" "$latest" "$update_available" "$running" "$state"
}

cmd_check() {
	need_root || exit 1
	build_version_info
}

cmd_status() {
	need_root || exit 1
	build_version_info
}

upgrade_main() {
	local arch

	need_root || return 1
	need_openwrt || return 1
	arch="$(detect_arch)"
	log "router arch: ${arch}"

	write_version_cache "$(installed_version)" "$(fetch_latest_version || true)"

	backup_current_config
	prepare_download_tools
	fetch_packages "$arch" || return 1
	install_packages "$arch" || return 1
	restore_config
	restart_service
	rm -rf "$DOWNLOAD_DIR"
	log "upgrade completed successfully"
	return 0
}

cmd_start() {
	need_root || exit 1

	if upgrade_running; then
		printf '{"error":"already_running"}\n'
		return 1
	fi

	: > "$LOG"
	(
		trap 'rm -f "$LOCK" "$VERSION_CACHE"' EXIT
		touch "$LOCK"
		if upgrade_main; then
			echo "STATUS=success"
		else
			log "upgrade failed"
			echo "STATUS=error"
		fi
	) >> "$LOG" 2>&1 &

	printf '{"started":true}\n'
}

usage() {
	echo "Usage: $0 check|start|status" >&2
	exit 1
}

case "${1:-}" in
	check)  cmd_check ;;
	start)  cmd_start ;;
	status) cmd_status ;;
	*)      usage ;;
esac
