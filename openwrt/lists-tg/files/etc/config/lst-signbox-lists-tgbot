config main 'main'
	option enabled '1'
	option token ''
	list restart_cmd '/etc/init.d/$([ -x /etc/init.d/forkop ] && echo forkop || echo podkop) restart'
	option auto_restart '1'
	option log_auto_refresh '1'
	option state_path '/var/lib/lst-signbox-lists-tgbot/state.json'
	option log_path '/etc/lst-signbox-lists-tgbot/logs/bot.log'
